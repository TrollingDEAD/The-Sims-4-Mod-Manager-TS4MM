<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="Sims4ModManager.Core.Localization.%(Filename)%(Extension)" />
    <!-- For the in-app "what's new" summary shown after a self-update; kept in sync automatically since it's the repo's own file. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Sims4ModManager.Core.CHANGELOG.md" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="BitMiracle.LibJpeg.NET" Version="1.5.324" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

</Project>
