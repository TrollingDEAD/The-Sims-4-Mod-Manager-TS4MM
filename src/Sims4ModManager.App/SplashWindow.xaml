<Window x:Class="Sims4ModManager.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sims 4 Mod Manager"
        Width="360" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app.ico">
    <Border CornerRadius="12" Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <Image Source="Resources/logo.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Sims 4 Mod Manager" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <!--
                A hand-rolled spinner instead of ui:ProgressRing, started explicitly in code-behind
                (SpinnerStoryboard.Begin() in the constructor) rather than via a Loaded trigger, so it's
                already running by the time the window is shown. This window itself is only up briefly:
                the mod scan that used to run synchronously in MainWindow's constructor (and would have
                frozen this animation - WPF does not composite further frames for a window whose UI
                thread has stopped pumping messages) now runs on a background thread
                (MainViewModel.RescanModsForStartupAsync), so MainWindow appears and this splash closes
                almost immediately; MainWindow's own "Checking ..." placeholder covers the scan itself.
            -->
            <Path x:Name="Spinner" Width="24" Height="24" Margin="0,20,0,8" Stretch="Uniform"
                  Data="M 12,2 A 10,10 0 1 1 2,12"
                  Stroke="#4C8DFF" StrokeThickness="2.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                </Path.RenderTransform>
                <Path.Resources>
                    <Storyboard x:Key="SpinnerStoryboard">
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                    </Storyboard>
                </Path.Resources>
            </Path>

            <TextBlock Text="Wird geladen …" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />
        </StackPanel>
    </Border>
</Window>
