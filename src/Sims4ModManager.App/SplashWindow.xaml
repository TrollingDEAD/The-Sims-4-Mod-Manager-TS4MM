<Window x:Class="Sims4ModManager.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Sims 4 Mod Manager"
        Width="360" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app.ico">
    <Border CornerRadius="12" Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <Image Source="Resources/app.ico" Width="72" Height="72" />
            <TextBlock Text="Sims 4 Mod Manager" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,20,0,8" />
            <TextBlock Text="Wird geladen …" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />
        </StackPanel>
    </Border>
</Window>
