<ui:FluentWindow x:Class="Sims4ModManager.App.SortWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Mods-Ordner sortieren" Width="760" Height="640" MinWidth="560" MinHeight="460"
                 Icon="Resources/app.ico"
                 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica" WindowCornerPreference="Round" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Mods-Ordner sortieren" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="TextSortAscending24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="18,6,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10"
                       Text="Ordnet die Mods nach Inhalt in Ordner wie „CAS - Haare“, „Objekte“ oder „Skript-Mods“ ein – auf Wunsch mit einem Unterordner pro Ersteller. Jeder Mod bleibt dabei einzeln schaltbar, Profile und Notizen bleiben erhalten. Skript-Dateien liegen höchstens einen Ordner tief, Packages höchstens fünf (sonst lädt das Spiel sie nicht). Alles lässt sich in einem Schritt über den Verlauf rückgängig machen." />

            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <CheckBox Content="Unterordner pro Ersteller" IsChecked="{Binding ByCreator}" Margin="0,0,18,0"
                          ToolTip="z. B. „CAS - Haare\Simstrouble“. Ohne erkannten Ersteller landet der Mod direkt im Kategorie-Ordner." />
                <CheckBox Content="Ordner (Sets) mit verschieben" IsChecked="{Binding IncludeFolders}" Margin="0,0,18,0"
                          ToolTip="Mod-Ordner werden als Ganzes in die Kategorie ihres Hauptinhalts verschoben. Ordner mit Skripten bleiben immer, wo sie sind." />
                <CheckBox Content="Bereits sortierte neu einordnen" IsChecked="{Binding Resort}"
                          ToolTip="Auch Mods, die schon in einem Sammelordner liegen, erneut einsortieren (z. B. nach Umschalten der Ersteller-Ordner)." />
            </WrapPanel>

            <TextBlock Grid.Row="2" Text="{Binding Summary}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:ListView ItemsSource="{Binding Groups}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Folder24" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding Folder, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding CountLabel, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Examples}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
                <TextBlock Grid.Row="1" Text="{Binding SkippedHeader}" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <ListBox Grid.Row="2" ItemsSource="{Binding Skipped}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ui:ProgressRing Grid.Row="4" IsIndeterminate="True" Height="24" Width="24" HorizontalAlignment="Left" Margin="0,10,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button Content="Abbrechen" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Jetzt sortieren" Icon="{ui:SymbolIcon TextSortAscending24}" Appearance="Primary"
                           Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
