<ui:FluentWindow x:Class="Sims4ModManager.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="Sims 4 Mod Manager" Height="780" Width="1320" MinHeight="700" MinWidth="1040"
                 Icon="Resources/app.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ToolTipService.InitialShowDelay="350"
                 ToolTipService.ShowDuration="20000">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RescanCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding History.UndoLatestCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding FocusGlobalSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F1" Command="{Binding ShowShortcutsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar with theme toggle -->
        <ui:TitleBar Grid.Row="0" Title="Sims 4 Mod Manager">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="16" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppVersion}" Style="{StaticResource CaptionText}" Opacity="0.6"
                           VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Sims 4 Mod Manager – Version" />
                <ui:Button Appearance="Transparent" BorderThickness="0" Padding="6,4" Margin="0,0,8,0" VerticalAlignment="Center"
                           Command="{Binding AppUpdate.ToggleChannelCommand}" ToolTip="{Binding AppUpdate.ChannelToggleTooltip}">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="15" Filled="{Binding AppUpdate.IncludePrereleases}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppUpdate.IncludePrereleases}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
                <ui:Button Appearance="Primary" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center"
                           Icon="{ui:SymbolIcon ArrowDownload24}" Content="{Binding AppUpdate.ActionLabel}"
                           Command="{Binding AppUpdate.RunActionCommand}"
                           Visibility="{Binding AppUpdate.IsAvailable, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="Neue Version von GitHub laden und installieren" />
                <!-- Global search: mods, creators, notes, in-game names, library, saves -->
                <Grid Width="320" Margin="0,0,8,0" DataContext="{Binding Search}">
                    <ui:TextBox x:Name="GlobalSearchBox" PlaceholderText="Überall suchen … (Strg+K)" Icon="{ui:SymbolIcon Search24}"
                                ClearButtonEnabled="True" Padding="6,3" MinHeight="28"
                                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                ToolTip="Sucht in Mods (Name, Ersteller, Kategorie, Notizen, Tags, Namen im Spiel), in der Bibliothek und in den Spielständen.">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding ClearCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding OpenCommand}" CommandParameter="{Binding Results[0]}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <Popup IsOpen="{Binding IsOpen}" PlacementTarget="{Binding ElementName=GlobalSearchBox}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" Width="460">
                        <Border Margin="0,4,0,0" Padding="6" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding ResultSummary}" Style="{StaticResource CaptionText}" Margin="6,2,6,6" />
                                <ListBox ItemsSource="{Binding Results}" MaxHeight="420" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         x:Name="SearchResults" SelectionChanged="SearchResults_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Border DockPanel.Dock="Left" Width="84" Margin="0,0,8,0" Padding="4,1" CornerRadius="4" VerticalAlignment="Top"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock Text="{Binding Kind}" FontSize="11" HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
                <ui:Button Appearance="Transparent" BorderThickness="0" Padding="8,4" Margin="0,0,2,0"
                           Click="OpenSetup_Click" ToolTip="Einrichtungsassistent öffnen">
                    <ui:SymbolIcon Symbol="Wand24" />
                </ui:Button>
                <Grid Margin="0,0,2,0">
                    <ui:Button x:Name="BackupMenuButton" Appearance="Transparent" BorderThickness="0" Padding="8,4"
                               Command="{Binding ToggleBackupMenuCommand}"
                               ToolTip="Einstellungen, Notizen und Profile exportieren/importieren (z. B. für einen PC-Wechsel)">
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:Button>
                    <Popup IsOpen="{Binding IsBackupMenuOpen}" PlacementTarget="{Binding ElementName=BackupMenuButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="260">
                        <Border Margin="0,4,0,0" Padding="8" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Sicherung" FontWeight="SemiBold" Margin="4,0,4,6" />
                                <ui:Button Content="Exportieren …" Icon="{ui:SymbolIcon ArrowExportUp24}" HorizontalContentAlignment="Left"
                                           HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                           Command="{Binding ExportBackupCommand}"
                                           ToolTip="Einstellungen, Mod-Notizen/Tags/Favoriten und Profile in eine Datei speichern." />
                                <ui:Button Content="Importieren …" Icon="{ui:SymbolIcon ArrowImport24}" HorizontalContentAlignment="Left"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding ImportBackupCommand}"
                                           ToolTip="Eine zuvor exportierte Sicherung übernehmen (startet die App neu)." />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <ui:Button Appearance="Transparent" BorderThickness="0" Padding="8,4" Margin="0,0,2,0"
                           Command="{Binding ShowShortcutsCommand}" ToolTip="Tastenkürzel anzeigen (F1)">
                    <ui:SymbolIcon Symbol="QuestionCircle24" />
                </ui:Button>
                <ui:Button Appearance="Transparent" BorderThickness="0" Padding="8,4" Margin="0,0,2,0"
                           Command="{Binding ToggleLanguageCommand}" ToolTip="Sprache wechseln / Switch language">
                    <TextBlock Text="{Binding OtherLanguageLabel}" FontWeight="SemiBold" />
                </ui:Button>
                <ui:Button Appearance="Transparent" BorderThickness="0" Padding="8,4" Margin="0,0,2,0"
                           Command="{Binding ToggleThemeCommand}"
                           ToolTip="Zwischen dunklem und hellem Design wechseln">
                    <ui:SymbolIcon>
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="WeatherSunny24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                        <Setter Property="Symbol" Value="WeatherMoon24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
                <Grid Margin="0,0,4,0">
                    <ui:Button x:Name="AccentMenuButton" Appearance="Transparent" BorderThickness="0" Padding="8,4"
                               Command="{Binding ToggleAccentMenuCommand}" ToolTip="Akzentfarbe wählen">
                        <ui:SymbolIcon Symbol="PaintBrush24" />
                    </ui:Button>
                    <Popup IsOpen="{Binding IsAccentMenuOpen}" PlacementTarget="{Binding ElementName=AccentMenuButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="188">
                        <Border Margin="0,4,0,0" Padding="8" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Akzentfarbe" FontWeight="SemiBold" Margin="4,0,4,6" />
                                <ui:Button Content="Windows-Standard" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                           Margin="0,0,0,6" Command="{Binding SetAccentColorCommand}"
                                           ToolTip="Folgt der Akzentfarbe von Windows" />
                                <ItemsControl ItemsSource="{Binding AccentPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="28" Height="28" Margin="2" Padding="0" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0"
                                                    Command="{Binding DataContext.SetAccentColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{Binding}">
                                                <Ellipse Width="20" Height="20" Fill="{Binding Converter={StaticResource HexToBrush}}"
                                                         Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="14,4,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Mods folder -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <ui:Button DockPanel.Dock="Right" Content="Spielen" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Margin="12,0,0,0"
                           Command="{Binding Health.PlayCommand}"
                           ToolTip="Die Sims 4 starten (Optionen im Tab „Übersicht“). Nach dem Spielen werden neue Fehlerprotokolle automatisch geprüft." />
                <ui:Button DockPanel.Dock="Right" Content="Ordner wählen …" Icon="{ui:SymbolIcon FolderOpen24}" Margin="6,0,0,0"
                           Click="ChooseFolder_Click"
                           ToolTip="Mods-Ordner manuell auswählen. Wird der Sims 4-Ordner selbst gewählt, wird automatisch dessen Mods-Ordner verwendet." />
                <ui:Button DockPanel.Dock="Right" Content="Automatisch erkennen" Icon="{ui:SymbolIcon Wand24}" Margin="6,0,0,0"
                           Command="{Binding DetectModsFolderCommand}"
                           ToolTip="Sucht den Sims 4-Ordner in allen Dokumente-Ordnern (auch OneDrive, jede Spielsprache) und wählt die zuletzt gespielte Installation." />
                <ui:Button DockPanel.Dock="Right" Content="Aktualisieren" Icon="{ui:SymbolIcon ArrowSync24}" Margin="6,0,0,0"
                           Command="{Binding RescanCommand}"
                           ToolTip="Mods-Ordner und Bibliothek neu einlesen (F5)" />
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Folder24" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding KnownModsPaths}" SelectedItem="{Binding SelectedKnownModsPath}"
                          VerticalContentAlignment="Center"
                          ToolTip="Aktiver Mods-Ordner. Die Liste enthält zuletzt genutzte und automatisch erkannte Ordner." />
            </DockPanel>

            <DockPanel Grid.Row="1">
            <!-- New download banner -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="14,8" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding HasPendingDownload, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="Installieren …" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Margin="6,0,0,0"
                                   Command="{Binding InstallPendingDownloadCommand}" />
                        <ui:Button Content="Ignorieren" Margin="6,0,0,0" Command="{Binding DismissPendingDownloadCommand}" />
                    </StackPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowDownload24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="Neuer Sims 4-Download: " /><Run Text="{Binding PendingDownloadName, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <TabControl SelectedIndex="{Binding SelectedTabIndex}">
                <!-- ============================== Overview (health check) ============================== -->
                <TabItem DataContext="{Binding Health}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="HeartPulse24" Margin="0,0,6,0" />
                            <TextBlock Text="Übersicht" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="4,10,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Update banner -->
                        <Border Grid.Row="0" Margin="0,0,0,10" Padding="14,10" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{StaticResource WarningBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNewPatch}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="Liste defekter Mods" Icon="{ui:SymbolIcon Open24}" Margin="6,0,0,0"
                                               Command="{Binding OpenBrokenModsListCommand}"
                                               ToolTip="Sucht im EA-Forum nach dem Community-Thread „Broken and Updated Mods“ für diese Spielversion." />
                                    <ui:Button Content="Verstanden" Icon="{ui:SymbolIcon Checkmark24}" Margin="6,0,0,0"
                                               Command="{Binding AcknowledgePatchCommand}"
                                               ToolTip="Hinweis bis zum nächsten Spiel-Update ausblenden." />
                                </StackPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowSync24" FontSize="22" Margin="0,0,12,0"
                                               Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}"><Run Text="Sims 4 wurde aktualisiert: " /><Run Text="{Binding GameVersionLabel, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Text="Nach Updates sind Skript-Mods und Gameplay-Mods oft kaputt, bis ihre Ersteller sie anpassen. Unten unter „Probleme“ lassen sie sich mit „Sicherer Modus“ vorübergehend deaktivieren." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Status cards -->
                        <StackPanel Grid.Row="1">
                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <!-- Game -->
                            <Border Margin="0,0,8,0" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Games24" Margin="0,0,8,0" />
                                        <TextBlock Text="Spiel" Style="{StaticResource SectionHeader}" />
                                        <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource WarningBrush}" VerticalAlignment="Center"
                                                ToolTip="Änderungen an Mods wirken erst nach einem Neustart des Spiels.">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GameRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="läuft gerade" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}"><Run Text="Version " /><Run Text="{Binding GameVersionLabel, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource HideWhenEmpty}" Text="{Binding PatchLabel}" Margin="0,2,0,8" />
                                    <StackPanel IsEnabled="{Binding HasOptions}"
                                                ToolTip="Diese Schalter entsprechen den Spieloptionen unter „Andere“. Sie werden in der Options.ini gespeichert – bitte bei geschlossenem Spiel ändern.">
                                        <ui:ToggleSwitch Content="Mods &amp; CC aktiviert" IsChecked="{Binding ModsEnabledInGame}" Margin="0,4,0,0" />
                                        <ui:ToggleSwitch Content="Skript-Mods erlaubt" IsChecked="{Binding ScriptModsEnabledInGame}" Margin="0,6,0,0" />
                                        <ui:ToggleSwitch Content="CC-Liste beim Spielstart" IsChecked="{Binding ShowModListAtStartup}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Cache -->
                            <Border Margin="4,0,4,0" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Broom24" Margin="0,0,8,0" />
                                        <TextBlock Text="Spiel-Cache" Style="{StaticResource SectionHeader}" />
                                    </StackPanel>
                                    <ui:Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="Cache leeren" Icon="{ui:SymbolIcon Delete24}" Margin="0,10,0,0"
                                               Command="{Binding ClearCacheCommand}"
                                               ToolTip="Löscht localthumbcache.package, avatarcache.package, cachestr und onlinethumbnailcache. Das Spiel baut sie beim nächsten Start neu auf – hilft bei fehlendem CC und alten Vorschaubildern." />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding CacheLabel}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                                   Text="Nach dem Hinzufügen oder Entfernen von Mods leeren – der Standard-Tipp aus allen Foren, wenn CC im Spiel fehlt." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Mods & export -->
                            <Border Margin="8,0,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="PuzzlePiece24" Margin="0,0,8,0" />
                                        <TextBlock Text="Mods" Style="{StaticResource SectionHeader}" />
                                    </StackPanel>
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <ui:Button Content="Liste exportieren …" Icon="{ui:SymbolIcon ArrowExport24}" Margin="0,0,6,4"
                                                   Command="{Binding ExportModListCommand}"
                                                   ToolTip="Mod-Liste als Text (für Discord und Foren) oder CSV (für Excel) speichern." />
                                        <ui:Button Icon="{ui:SymbolIcon Copy24}" Margin="0,0,6,4" Command="{Binding CopyModListCommand}"
                                                   ToolTip="Mod-Liste in die Zwischenablage kopieren – z. B. für eine Support-Anfrage." />
                                    </WrapPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ModsLabel}" />
                                        <ui:ToggleSwitch Content="Download-Ordner überwachen" Margin="0,10,0,0"
                                                         IsChecked="{Binding DataContext.WatchDownloads, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         ToolTip="Meldet neue Sims 4-Downloads (Mods, Tray-Dateien, Archive) im Windows-Download-Ordner und bietet an, sie zu installieren." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Play bar: start the game with a profile, cache cleanup and save backup -->
                        <Border Margin="0,0,0,10" Padding="14,10" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Left" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Margin="0,0,16,0" Padding="18,6"
                                           Content="Spielen" Command="{Binding PlayCommand}"
                                           ToolTip="Wendet die gewählten Optionen an, startet Die Sims 4 und prüft nach dem Beenden automatisch auf neue Fehlerprotokolle." />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" MaxWidth="320" Text="{Binding InstallLabel, Mode=OneTime}" ToolTip="{Binding InstallLabel, Mode=OneTime}" />
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Profil:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Width="190" Margin="0,0,16,0" ItemsSource="{Binding PlayProfiles}" SelectedItem="{Binding PlayProfile}"
                                              ToolTip="Dieses Profil wird vor dem Start angewendet – z. B. „Nur CC“ für Bauprojekte." />
                                    <CheckBox Content="Cache leeren" IsChecked="{Binding ClearCacheBeforePlay}" Margin="0,0,16,0" VerticalAlignment="Center"
                                              ToolTip="Löscht vor jedem Start den Spiel-Cache, damit neuer CC sicher erscheint." />
                                    <CheckBox Content="Spielstände sichern" IsChecked="{Binding BackupSavesBeforePlay}" VerticalAlignment="Center"
                                              ToolTip="Sichert vor jedem Start alle Spielstände (Tab „Spielstände“ → Sicherungen)." />
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                        </StackPanel>

                        <!-- Problems header -->
                        <DockPanel Grid.Row="2" Margin="0,4,0,8">
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Wand24}" Appearance="Primary" Command="{Binding FixAllSafeCommand}"
                                       ToolTip="Behebt alle Probleme, bei denen nur aufgeräumt wird: Dateien aussortieren (nicht löschen), leere Ordner entfernen, Spielschalter einschalten, Cache leeren. Alles lässt sich rückgängig machen.">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BulkFixCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <TextBlock><Run Text="Alle sicheren beheben (" /><Run Text="{Binding BulkFixCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            </ui:Button>
                            <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,8,0" FontSize="20" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverallSeverity}" Value="Info">
                                                <Setter Property="Symbol" Value="Info24" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OverallSeverity}" Value="Warning">
                                                <Setter Property="Symbol" Value="Warning24" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OverallSeverity}" Value="Error">
                                                <Setter Property="Symbol" Value="ErrorCircle24" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Probleme" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Summary}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Problems list -->
                        <Grid Grid.Row="3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,0,6,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" BorderThickness="1"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                <DockPanel>
                                                    <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,12,0" FontSize="20" VerticalAlignment="Top">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Info24" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                        <Setter Property="Symbol" Value="Warning24" />
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                        <Setter Property="Symbol" Value="ErrorCircle24" />
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                                        <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,6,0"
                                                                   Command="{Binding DataContext.ShowPathsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}" ToolTip="Erste betroffene Datei im Explorer zeigen"
                                                                   Visibility="{Binding HasPaths, Converter={StaticResource BoolToVisibility}}" />
                                                        <ui:Button Content="{Binding FixLabel}" Icon="{ui:SymbolIcon Wrench24}"
                                                                   Command="{Binding DataContext.FixIssueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   ToolTip="Automatisch beheben – wird im Verlauf gesichert und lässt sich rückgängig machen."
                                                                   Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  ·  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Normal" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Description}" Margin="0,3,0,0" />
                                                        <Expander Margin="0,6,0,0" Header="{Binding PathsHeader}"
                                                                  Visibility="{Binding HasPaths, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl ItemsSource="{Binding PathPreview}" Margin="4,4,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                                                   Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Issues.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="40" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource EmptyStateText}" Margin="0,8,0,0" Text="{Binding Summary}" />
                            </StackPanel>

                            <!-- Busy overlay -->
                            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.85" CornerRadius="8"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" />
                                    <TextBlock Text="Prüfung läuft …" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ============================== Mods ============================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PuzzlePiece24" Margin="0,0,6,0" />
                            <TextBlock Text="Mods" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="4,10,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Toolbar: search, filter, bulk actions -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="Sortieren …" Icon="{ui:SymbolIcon TextSortAscending24}" Margin="6,0,0,0"
                                           Command="{Binding OpenSortCommand}"
                                           ToolTip="Mods nach Inhalt (und Ersteller) in Ordner wie „CAS - Haare“ oder „Objekte“ einsortieren – mit Vorschau, rückgängig machbar." />
                                <ui:Button Content="Zusammenführen …" Icon="{ui:SymbolIcon Merge24}" Margin="6,0,0,0"
                                           Command="{Binding OpenMergeCommand}"
                                           ToolTip="Viele kleine CC-Dateien zu einem Package zusammenführen (verkürzt die Ladezeit) – jederzeit wieder zerlegbar." />
                                <ui:Button Content="Alle aktivieren" Icon="{ui:SymbolIcon CheckmarkCircle24}" Margin="6,0,0,0"
                                           Command="{Binding EnableAllCommand}"
                                           ToolTip="Alle Mods aktivieren (entfernt die Endung .disabled)" />
                                <ui:Button Content="Alle deaktivieren" Icon="{ui:SymbolIcon DismissCircle24}" Margin="6,0,0,0"
                                           Command="{Binding DisableAllCommand}"
                                           ToolTip="Alle Mods deaktivieren – z. B. um zu prüfen, ob ein Problem an Mods liegt. Dateien werden nur umbenannt, nicht gelöscht." />
                            </StackPanel>
                            <ui:TextBox x:Name="ModSearchBox" Width="260" Margin="0,0,8,0"
                                        PlaceholderText="Mods durchsuchen … (Strg+F)" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                                        Text="{Binding ModSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Width="200" ItemsSource="{Binding ModFilters}" SelectedItem="{Binding ModFilter}"
                                      ToolTip="Mod-Liste filtern" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ModCountLabel}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                            <Border />
                        </DockPanel>

                        <!-- Mods list + conflicts side by side -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.6*" MinWidth="560" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.4*" MinWidth="340" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <DataGrid x:Name="ModsGrid"
                                          ItemsSource="{Binding ModsView}" SelectedItem="{Binding SelectedMod}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="False" SelectionMode="Single" HeadersVisibility="Column"
                                          GridLinesVisibility="None" RowHeight="30">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                            <Style.Triggers>
                                                <!-- Disabled mods are dimmed so the active set stands out. -->
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60">
                                            <DataGridCheckBoxColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
                                                    <Setter Property="ToolTip" Value="Häkchen setzen/entfernen schaltet den Mod sofort ein bzw. aus." />
                                                </Style>
                                            </DataGridCheckBoxColumn.HeaderStyle>
                                        </DataGridCheckBoxColumn>
                                        <DataGridTemplateColumn Header="★" Width="34" SortMemberPath="IsFavorite" IsReadOnly="True" CanUserSort="True">
                                            <DataGridTemplateColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
                                                    <Setter Property="ToolTip" Value="Favorit" />
                                                </Style>
                                            </DataGridTemplateColumn.HeaderStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:Button Appearance="Transparent" BorderThickness="0" Padding="4,2" HorizontalAlignment="Center"
                                                               Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Als Favorit markieren/entfernen">
                                                        <ui:SymbolIcon Symbol="Star28" FontSize="16" Filled="{Binding IsFavorite}">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FFC83D" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </ui:Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Name" Width="*" MinWidth="150" SortMemberPath="DisplayName" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DockPanel VerticalAlignment="Center">
                                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning16" Margin="0,0,6,0"
                                                                       Foreground="{StaticResource WarningBrush}" ToolTip="{Binding ConflictTooltip}">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                        <!-- Badge for folder mods where only some files are enabled -->
                                                        <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6,1" CornerRadius="4"
                                                                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                                                ToolTip="Nur ein Teil der Dateien dieses Mods ist aktiv. Häkchen setzen aktiviert alle.">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPartiallyEnabled}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="teilweise" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                                        </Border>
                                                        <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Note16" Margin="6,0,0,0"
                                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" ToolTip="{Binding NoteTooltip}"
                                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                                        <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ArrowSwap16" Margin="6,0,0,0"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding GameReplacementTooltip}"
                                                                       Visibility="{Binding ReplacesGame, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- Fixed widths: Auto columns get squeezed unpredictably when space is short. -->
                                        <DataGridTemplateColumn Header="Kategorie" Width="130" SortMemberPath="CategoryLabel" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DockPanel VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding KindTooltip}">
                                                        <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Symbol" Value="Document16" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Model.IsFolder}" Value="True">
                                                                            <Setter Property="Symbol" Value="Folder16" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                        <TextBlock Text="{Binding CategoryLabel}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Ersteller" Binding="{Binding CreatorLabel}" Width="100" IsReadOnly="True"
                                                            ElementStyle="{StaticResource TrimmedCell}">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
                                                    <Setter Property="ToolTip" Value="Aus Dateinamen und Package-Inhalten erkannt – eine Schätzung, kein Eintrag des Erstellers." />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Größe" Binding="{Binding SizeLabel}" Width="72" IsReadOnly="True"
                                                            SortMemberPath="Model.TotalSizeBytes" />
                                        <DataGridTemplateColumn Header="Geändert" Width="88" SortMemberPath="Model.LastModifiedUtc" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LastModifiedLabel}" VerticalAlignment="Center" ToolTip="{Binding LastModifiedTooltip}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Tray" Binding="{Binding TrayUsageLabel}" Width="54" IsReadOnly="True"
                                                            SortMemberPath="TrayUsage">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
                                                    <Setter Property="ToolTip" Value="In wie vielen Bibliothekseinträgen (Haushalte, Grundstücke, Räume) dieser Mod verwendet wird." />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Keine Mods gefunden – Suche oder Filter anpassen, oder einen anderen Mods-Ordner wählen.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=ModsGrid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                                          ToolTip="Ziehen, um die Breite anzupassen" />

                            <!-- Details of the selected mod | conflicts -->
                            <TabControl Grid.Column="2" SelectedIndex="{Binding ModSideTabIndex}">
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Info24" Margin="0,0,6,0" />
                                            <TextBlock Text="Details" />
                                        </StackPanel>
                                    </TabItem.Header>
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      DataContext="{Binding ModDetails}">
                                            <StackPanel Margin="2,8,6,6">
                                                <DockPanel>
                                                    <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Appearance="Transparent" BorderThickness="0" Padding="4,2"
                                                               Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding Mod}"
                                                               ToolTip="Als Favorit markieren/entfernen">
                                                        <ui:SymbolIcon Symbol="Star28" FontSize="20" Filled="{Binding Mod.IsFavorite}">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Mod.IsFavorite}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FFC83D" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </ui:Button>
                                                    <Border DockPanel.Dock="Left" Width="96" Height="96" Margin="0,0,12,0" CornerRadius="8"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <ui:SymbolIcon Symbol="Image24" FontSize="28" Foreground="{DynamicResource TextFillColorDisabledBrush}" />
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" />
                                                        <TextBlock Text="{Binding CategoryLabel}" Margin="0,4,0,0" />
                                                        <TextBlock Style="{StaticResource CaptionText}"><Run Text="Ersteller: " /><Run Text="{Binding CreatorLabel, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock Text="{Binding CatalogLabel}" Style="{StaticResource HideWhenEmpty}" />
                                                        <TextBlock Text="{Binding LocationLabel}" Style="{StaticResource CaptionText}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                        Visibility="{Binding HasGameLabel, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Dieser Mod ersetzt Ressourcen des Spiels selbst (Default Replacement bzw. Tuning-Override). Tuning-Overrides brechen nach Spiel-Updates am häufigsten.">
                                                    <DockPanel>
                                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowSwap24" Margin="0,0,8,0" VerticalAlignment="Top" />
                                                        <StackPanel>
                                                            <TextBlock Text="Ersetzt Spielinhalte" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding GameLabel}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <ui:Button Content="Im Explorer zeigen" Icon="{ui:SymbolIcon Open24}" Margin="0,0,6,6" Command="{Binding OpenInExplorerCommand}" />
                                                    <ui:Button Content="Als Sammelordner" Icon="{ui:SymbolIcon FolderMultiple24}" Margin="0,0,6,6"
                                                               Command="{Binding MakeCollectionCommand}"
                                                               Visibility="{Binding CanMakeCollection, Converter={StaticResource BoolToVisibility}}"
                                                               ToolTip="Jede Datei und jeder Unterordner dieses Ordners wird ein eigener Mod (z. B. für selbst angelegte Sammelordner wie „Haare“)." />
                                                </WrapPanel>

                                                <TextBlock Text="Notizen" Style="{StaticResource SectionHeader}" Margin="0,8,0,4" />
                                                <ui:TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Eigene Notiz …"
                                                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="140" VerticalScrollBarVisibility="Auto" />
                                                <ui:TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Warum installiert? (z. B. für eine Challenge)" Margin="0,6,0,0" />
                                                <ui:TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tags, durch Komma getrennt (z. B. Hochzeit, Lieblinge)" Margin="0,6,0,0"
                                                            Icon="{ui:SymbolIcon Tag24}" ToolTip="Tags lassen sich in der Mod-Suche und der globalen Suche finden." />
                                                <DockPanel Margin="0,6,0,0">
                                                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Open24}" Margin="6,0,0,0" ToolTip="Link öffnen"
                                                               Command="{Binding OpenUrlCommand}" CommandParameter="{Binding DownloadUrl}" />
                                                    <ui:TextBox Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Download-Link (https://…)" Icon="{ui:SymbolIcon Link24}" />
                                                </DockPanel>
                                                <DockPanel Margin="0,6,0,0">
                                                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Open24}" Margin="6,0,0,0" ToolTip="Link öffnen"
                                                               Command="{Binding OpenUrlCommand}" CommandParameter="{Binding CreatorUrl}" />
                                                    <ui:TextBox Text="{Binding CreatorUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Seite des Erstellers (https://…)" Icon="{ui:SymbolIcon Person24}" />
                                                </DockPanel>
                                                <ui:Button Content="Notizen speichern" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="0,8,0,0"
                                                           Command="{Binding SaveNotesCommand}" IsEnabled="{Binding IsDirty}"
                                                           ToolTip="Notizen liegen außerhalb des Mods-Ordners und bleiben beim Umschalten, Sortieren und Aktualisieren erhalten." />

                                                <TextBlock Text="Dateien" Style="{StaticResource SectionHeader}" Margin="0,14,0,4" />
                                                <ItemsControl ItemsSource="{Binding Files}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                        <TextBlock Text="Einen Mod in der Liste auswählen, um Vorschau, Kategorie, Ersteller und Notizen zu sehen.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModDetails}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="BranchFork24" Margin="0,0,6,0" />
                                            <TextBlock><Run Text="Konflikte (" /><Run Text="{Binding ConflictGroups.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                                        </StackPanel>
                                    </TabItem.Header>
                            <Grid Margin="0,8,0,0">
                                <!-- Min heights keep both lists usable when the warnings are expanded or the window is small. -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="0.8*" MinHeight="96" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1.2*" MinHeight="170" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Wand24}" Appearance="Primary" Margin="8,0,0,0"
                                               VerticalAlignment="Top" Command="{Binding ApplySafeProposalsCommand}"
                                               ToolTip="Deaktiviert in einem Schritt alle doppelt installierten Dateien, älteren Versionen, NonHQ-Varianten neben HQ und Einzeldateien, die schon in einem MERGED-Set stecken. Nichts wird gelöscht; alles lässt sich über den Verlauf rückgängig machen.">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SafeProposalCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                        <TextBlock><Run Text="Sichere Lösungen (" /><Run Text="{Binding SafeProposalCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                                    </ui:Button>
                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="BranchFork24" Margin="0,0,6,0" VerticalAlignment="Top" />
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding ConflictSummary}"
                                               ToolTip="Ressourcen, die mehrere aktive Mods in unterschiedlicher Version bereitstellen – im Spiel gewinnt nur eine davon. Byte-identische Duplikate werden ignoriert." />
                                </DockPanel>

                                <!-- One row per set of mods that collide with each other -->
                                <Grid Grid.Row="1">
                                    <ui:ListView ItemsSource="{Binding ConflictGroups}" SelectedItem="{Binding SelectedConflictGroup}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ui:ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Width="58" Text="{Binding SeverityLabel}"
                                                                   Style="{StaticResource SeverityText}" />
                                                        <TextBlock Text="{Binding ModNamesLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock Margin="58,2,0,0" Text="{Binding SummaryLabel}" Style="{StaticResource CaptionText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ui:ListView.ItemTemplate>
                                    </ui:ListView>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="32" Foreground="{StaticResource SuccessBrush}" />
                                        <TextBlock Style="{StaticResource EmptyStateText}" Margin="0,6,0,0" Text="Keine Konflikte zwischen aktiven Mods." />
                                    </StackPanel>
                                </Grid>

                                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent" />

                                <!-- Details of the selected group: solutions and affected resources -->
                                <TabControl Grid.Row="3" Grid.RowSpan="2">
                                    <TabItem>
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Wand24" Margin="0,0,6,0" />
                                                <TextBlock><Run Text="Lösungen (" /><Run Text="{Binding GroupProposals.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                                            </StackPanel>
                                        </TabItem.Header>
                                        <Grid>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding GroupProposals}" Margin="0,6,4,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6" BorderThickness="1"
                                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <Border DockPanel.Dock="Right" Padding="6,1" CornerRadius="4" BorderThickness="1" VerticalAlignment="Top">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSafe}" Value="True">
                                                                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock Text="{Binding BadgeLabel}" FontSize="11" Style="{StaticResource CaptionText}" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource CaptionText}" Margin="0,4,0,8" />
                                                                    <ui:Button HorizontalAlignment="Left" Icon="{ui:SymbolIcon Checkmark24}"
                                                                               Command="{Binding DataContext.ApplyProposalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                               CommandParameter="{Binding}" ToolTip="{Binding ActionTooltip}">
                                                                        <ui:Button.Style>
                                                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                                                        <Setter Property="Appearance" Value="Primary" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ui:Button.Style>
                                                                        <TextBlock Text="{Binding ActionLabel}" TextWrapping="Wrap" />
                                                                    </ui:Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock Text="Für diese Gruppe gibt es keinen automatischen Lösungsvorschlag.">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GroupProposals.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </TabItem>
                                    <TabItem ToolTip="Farbe = Schwere: rot hoch, orange mittel, grün niedrig">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="DocumentBulletList24" Margin="0,0,6,0" />
                                                <TextBlock><Run Text="Ressourcen (" /><Run Text="{Binding SelectedConflictGroup.Items.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                                            </StackPanel>
                                        </TabItem.Header>
                                <ui:ListView Margin="0,6,0,0" ItemsSource="{Binding SelectedConflictGroup.Items}">
                                    <ui:ListView.View>
                                        <ui:GridView>
                                            <!-- Type colored by severity (the severity itself is in the tooltip) - saves a column. -->
                                            <ui:GridViewColumn Header="Typ" Width="120">
                                                <ui:GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource SeverityText}"
                                                                   FontWeight="Normal" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding SeverityTooltip}" />
                                                    </DataTemplate>
                                                </ui:GridViewColumn.CellTemplate>
                                            </ui:GridViewColumn>
                                            <ui:GridViewColumn Header="Ressource / Modul" Width="250">
                                                <ui:GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding KeyLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                                   ToolTip="{Binding KeyLabel}" />
                                                    </DataTemplate>
                                                </ui:GridViewColumn.CellTemplate>
                                            </ui:GridViewColumn>
                                        </ui:GridView>
                                    </ui:ListView.View>
                                </ui:ListView>
                                    </TabItem>
                                </TabControl>

                                <!-- Files that could not be checked or are ignored by the game -->
                                <Expander Grid.Row="5" Margin="0,8,0,0">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0" />
                                            <TextBlock><Run Text="Warnungen: " /><Run Text="{Binding ScanWarnings.Count, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Expander.Style>
                                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScanWarnings.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Expander.Style>
                                    <ListBox ItemsSource="{Binding ScanWarnings}" MaxHeight="110"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </Grid>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Box24" Margin="0,0,6,0" />
                                            <TextBlock Text="Inhalt" />
                                        </StackPanel>
                                    </TabItem.Header>
                                    <Grid DataContext="{Binding ModDetails}" Margin="2,8,4,4">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <!-- nothing selected: no stale buttons -->
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ComboBox ItemsSource="{Binding PackageFiles}" SelectedItem="{Binding SelectedPackage}" DisplayMemberPath="RelativePathInMod"
                                                  Visibility="{Binding HasPackages, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Row="1" Text="{Binding ContentSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <WrapPanel Grid.Row="2" Margin="0,8,0,6">
                                            <ui:Button Content="Optimieren" Icon="{ui:SymbolIcon ArrowMinimize24}" Margin="0,0,6,6"
                                                       Command="{Binding OptimizeCommand}" IsEnabled="{Binding CanOptimize}"
                                                       ToolTip="Doppelte Einträge entfernen und unkomprimierte Ressourcen verlustfrei komprimieren (wie „Batch Fix“ in Sims 4 Studio). Rückgängig machbar." />
                                            <ui:Button Content="Zerlegen" Icon="{ui:SymbolIcon SplitVertical24}" Margin="0,0,6,6"
                                                       Command="{Binding UnmergeCommand}"
                                                       Visibility="{Binding CanUnmerge, Converter={StaticResource BoolToVisibility}}"
                                                       ToolTip="Ein zusammengeführtes Package wieder in seine Originaldateien aufteilen – z. B. um einen Teil davon zu entfernen." />
                                            <TextBlock Text="{Binding OptimizeHint}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <ui:ListView Grid.Row="3" ItemsSource="{Binding ResourceTypes}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <ui:ListView.View>
                                                <ui:GridView>
                                                    <ui:GridViewColumn Header="Typ" Width="190" DisplayMemberBinding="{Binding Name}" />
                                                    <ui:GridViewColumn Header="Anzahl" Width="64" DisplayMemberBinding="{Binding Count}" />
                                                    <ui:GridViewColumn Header="Gespeichert" Width="90" DisplayMemberBinding="{Binding StoredLabel}" />
                                                    <ui:GridViewColumn Header="Entpackt" Width="90" DisplayMemberBinding="{Binding MemoryLabel}" />
                                                    <ui:GridViewColumn Header="ID" Width="90" DisplayMemberBinding="{Binding TypeId}" />
                                                </ui:GridView>
                                            </ui:ListView.View>
                                        </ui:ListView>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <!-- Profiles -->
                        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,10" CornerRadius="8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <ui:SymbolIcon Symbol="People24" Margin="0,0,6,0" />
                                    <TextBlock Text="Profile" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                                </StackPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <ComboBox Width="180" Margin="0,0,6,0" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}"
                                              ToolTip="Gespeicherte Mod-Auswahlen" />
                                    <ui:Button Content="Anwenden" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Margin="0,0,6,0"
                                               Command="{Binding ApplySelectedProfileCommand}"
                                               ToolTip="Aktiviert genau die Mods des Profils und deaktiviert alle anderen." />
                                    <ui:Button Content="Löschen" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,24,0"
                                               Command="{Binding DeleteSelectedProfileCommand}"
                                               ToolTip="Ausgewähltes Profil löschen (die Mods selbst bleiben unverändert)." />
                                    <ui:TextBox Width="180" Margin="0,0,6,0" PlaceholderText="Neuer Profilname"
                                                Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="Name für die aktuelle Mod-Auswahl – Enter speichert.">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SaveProfileCommand}" />
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>
                                    <ui:Button Content="Als Profil speichern" Icon="{ui:SymbolIcon Save24}"
                                               Command="{Binding SaveProfileCommand}"
                                               ToolTip="Speichert, welche Mods gerade aktiv sind. Ein vorhandenes Profil gleichen Namens wird aktualisiert." />
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================== Catalog ============================== -->
                <TabItem DataContext="{Binding Catalog}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Grid24" Margin="0,0,6,0" />
                            <TextBlock Text="Katalog" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="4,10,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        </DockPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <ui:TextBox Width="260" Margin="0,0,8,6" PlaceholderText="Name, Datei oder Ersteller …" Icon="{ui:SymbolIcon Search24}"
                                        ClearButtonEnabled="True" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                            <ComboBox Width="190" Margin="0,0,8,6" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding CategoryFilter}"
                                      ToolTip="Kategorie (aus dem Inhalt der Packages ermittelt)" />
                            <ComboBox Width="160" Margin="0,0,8,6" ItemsSource="{Binding AgeOptions}" SelectedItem="{Binding AgeFilter}"
                                      ToolTip="Altersstufe (nur CAS-Inhalte)" />
                            <ComboBox Width="110" Margin="0,0,8,6" ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding GenderFilter}"
                                      ToolTip="Geschlecht (nur CAS-Inhalte)" />
                            <CheckBox Content="Nur aktive" IsChecked="{Binding OnlyEnabled}" Margin="4,0,12,6" VerticalAlignment="Center" />
                            <ui:Button Content="Filter zurücksetzen" Icon="{ui:SymbolIcon FilterDismiss24}" Command="{Binding ResetFiltersCommand}" Margin="0,0,12,6" />
                            <TextBlock Text="{Binding CountLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,0,6" />
                        </WrapPanel>

                        <Grid Grid.Row="2">
                            <ListBox x:Name="CatalogList" ItemsSource="{Binding TilesView}" SelectedItem="{Binding SelectedTile}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ui:VirtualizingWrapPanel ItemSize="156,196" SpacingMode="Uniform" StretchItems="False" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="Margin" Value="3" />
                                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="140" Height="180">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                              Command="{Binding DataContext.ShowInModsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                              CommandParameter="{Binding}" />
                                            </Grid.InputBindings>
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="In der Mod-Liste zeigen" Command="{Binding PlacementTarget.Tag.ShowInModsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Aktivieren/Deaktivieren" Command="{Binding PlacementTarget.Tag.ToggleModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Im Explorer zeigen" Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.Tag>
                                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </Grid.Tag>
                                            <Border CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="Image24" FontSize="26" Foreground="{DynamicResource TextFillColorDisabledBrush}" />
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Padding="4,1" CornerRadius="4"
                                                            Background="{StaticResource WarningBrush}"
                                                            Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                                                        <TextBlock Text="aus" FontSize="10" Foreground="Black" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="2,6,2,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="32" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Keine Einträge – Filter anpassen oder warten, bis der Katalog aufgebaut ist.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=CatalogList}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ============================== Library (Tray) ============================== -->
                <TabItem DataContext="{Binding Tray}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Library24" Margin="0,0,6,0" />
                            <TextBlock Text="Bibliothek (Tray)" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid x:Name="TrayRoot" Margin="4,10,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="260" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <!-- Grid instead of DockPanel: the search box shrinks first, so the filter never gets pushed out. -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="170" MaxWidth="340" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="3" HorizontalAlignment="Right">
                                <ui:Button Content="Downloads installieren …" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Margin="6,0,0,4"
                                           Command="{Binding InstallDownloadsCommand}"
                                           ToolTip="ZIP/RAR/7z-Archive oder einzelne Dateien installieren: Tray-Dateien kommen unverändert nach Tray, CC (.package/.ts4script) nach Mods. Vor dem Kopieren siehst du eine Übersicht." />
                                <ui:Button Content="Ordner installieren …" Icon="{ui:SymbolIcon FolderAdd24}" Margin="6,0,0,4"
                                           Command="{Binding InstallDownloadFolderCommand}"
                                           ToolTip="Einen bereits entpackten Download-Ordner installieren – oder einen entfernten Eintrag aus der Sicherung wiederherstellen." />
                                <ui:Button Content="Sicherung …" Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="6,0,0,4"
                                           Command="{Binding CreateBackupCommand}"
                                           ToolTip="Tray (Bibliothek) und Saves (Spielstände), optional auch Mods, als ZIP sichern." />
                                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Margin="6,0,0,4"
                                           Command="{Binding RefreshCommand}"
                                           ToolTip="Bibliothek neu einlesen" />
                            </WrapPanel>
                            <ui:TextBox x:Name="TraySearchBox" Grid.Column="0" Margin="0,0,8,4"
                                        PlaceholderText="Name, Ersteller, Sims, Tags … (Strg+F)" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Sucht in Name, Ersteller, Sims, Beschreibung und Tags" />
                            <ComboBox Grid.Column="1" Width="180" Margin="0,0,0,4"
                                      ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}"
                                      ToolTip="Nach Art filtern oder nur problematische Einträge zeigen" />
                        </Grid>

                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionText}" Text="{Binding TrayPath}" Margin="16,0,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="420" ToolTip="{Binding TrayPath}" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Summary}" />
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" MinWidth="440" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" MinWidth="420" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <DataGrid x:Name="TrayGrid" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}" HorizontalScrollBarVisibility="Disabled"
                                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                          GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="30">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ShowInExplorerCommand}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Typ" Width="52" SortMemberPath="TypeLabel">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding TypeLabel}">
                                                        <ui:SymbolIcon FontSize="18">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Symbol" Value="Box24" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Model.Type}" Value="Household">
                                                                            <Setter Property="Symbol" Value="People24" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Model.Type}" Value="Lot">
                                                                            <Setter Property="Symbol" Value="BuildingHome24" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Model.Type}" Value="Room">
                                                                            <Setter Property="Symbol" Value="Home24" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="130" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Ersteller" Binding="{Binding Creator}" Width="*" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Sims" Binding="{Binding SimsLabel}" Width="1.5*" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="CC" Binding="{Binding CcLabel}" Width="Auto" SortMemberPath="Cc.Count">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
                                                    <Setter Property="ToolTip" Value="Anzahl verwendeter CC-Dateien aus deinem Mods-Ordner (davon deaktiviert)" />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="StatusLabel">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ProblemsLabel}">
                                                        <ui:SymbolIcon Margin="0,0,4,0">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasDisabledCc}" Value="True">
                                                                            <Setter Property="Symbol" Value="Warning24" />
                                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsComplete}" Value="False">
                                                                            <Setter Property="Symbol" Value="ErrorCircle24" />
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                        <TextBlock Text="{Binding StatusLabel}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Datum" Binding="{Binding DateLabel}" Width="96" SortMemberPath="SortDate" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Keine Einträge – über „Downloads installieren“ Haushalte, Grundstücke oder Räume hinzufügen, oder Suche/Filter anpassen.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=TrayGrid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                            <!-- Details of the selected item -->
                            <Border Grid.Column="2" Padding="14,12" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                <!-- Placeholder while nothing is selected -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:SymbolIcon Symbol="Library24" FontSize="32" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Style="{StaticResource EmptyStateText}" Margin="0,8,0,0"
                                               Text="Einen Eintrag links auswählen, um Details, verwendeten CC und Aktionen zu sehen." />
                                </StackPanel>
                                <DockPanel DataContext="{Binding SelectedItem}">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>

                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                                            <Run Text="{Binding TypeLabel, Mode=OneWay}" /><Run Text=" von " /><Run Text="{Binding Creator, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <!-- The file list lives in the tooltip so the CC list keeps its space. -->
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" Text="{Binding DetailsLabel}" Cursor="Help">
                                            <TextBlock.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="Tray-Dateien" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                    <ItemsControl ItemsSource="{Binding FileNames}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                                </StackPanel>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding TagsLabel}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="WordEllipsis" ToolTip="{Binding Model.Metadata.Tags}"
                                                   Style="{StaticResource HideWhenEmpty}" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding SimsLabel, StringFormat='Sims: {0}'}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SimsLabel}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource DangerBrush}" Text="{Binding ProblemsLabel}"
                                                   TextWrapping="Wrap" Style="{StaticResource HideWhenEmpty}" />
                                        <!-- From the game index (tab "Spiel") -->
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource HideWhenEmpty}" Text="{Binding PacksLabel}"
                                                   ToolTip="Packs, aus denen der Eintrag Objekte oder CAS-Teile verwendet. Ohne sie fehlen diese Teile im Spiel." />
                                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding MissingLabel}"
                                                   ToolTip="Teile, die weder ein Mod noch das Spiel enthält – meist fehlender CC. Bei Grundstücken und Räumen speichert das Spiel die Daten komprimiert; dort ist diese Prüfung nicht möglich.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource HideWhenEmpty}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMissing}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,6,0,0" Text="{Binding Description}" MaxHeight="58" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Description}" Style="{StaticResource HideWhenEmpty}" />

                                        <WrapPanel Margin="0,12,0,6" DataContext="{Binding DataContext, ElementName=TrayRoot}">
                                            <ui:Button Content="CC aktivieren" Icon="{ui:SymbolIcon CheckmarkCircle24}" Appearance="Primary" Margin="0,0,6,6"
                                                       Command="{Binding EnableRequiredCcCommand}"
                                                       ToolTip="Aktiviert alle deaktivierten Mods, die dieser Eintrag verwendet." />
                                            <ui:Button Content="Exportieren" Icon="{ui:SymbolIcon FolderArrowRight24}" Margin="0,0,6,6"
                                                       Command="{Binding ExportFolderCommand}"
                                                       ToolTip="Tray-Dateien und verwendeten CC in einen Ordner kopieren (Tray\ + Mods\) – z. B. zum Weitergeben." />
                                            <ui:Button Icon="{ui:SymbolIcon FolderZip24}" Margin="0,0,6,6"
                                                       Command="{Binding ExportZipCommand}"
                                                       ToolTip="Als ZIP exportieren – wie „Exportieren“, aber als einzelnes Archiv." />
                                            <ui:Button Icon="{ui:SymbolIcon Open24}" Margin="0,0,6,6"
                                                       Command="{Binding ShowInExplorerCommand}"
                                                       ToolTip="Tray-Dateien im Explorer zeigen (auch per Doppelklick auf den Eintrag)" />
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Margin="0,0,6,6"
                                                       Command="{Binding DeleteSelectedCommand}"
                                                       ToolTip="Aus der Bibliothek entfernen – die Dateien werden in einen Sicherungsordner verschoben, der CC bleibt unverändert." />
                                        </WrapPanel>

                                        <TextBlock Style="{StaticResource SectionHeader}" FontSize="13" Margin="0,4,0,6">
                                            <Run Text="Verwendeter CC" /><Run Text=" (" /><Run Text="{Binding Cc.Count, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>


                                    <Grid>
                                        <ui:ListView x:Name="CcList" ItemsSource="{Binding Cc}" MinHeight="130">
                                            <ui:ListView.View>
                                                <ui:GridView>
                                                    <ui:GridViewColumn Header="Mod" Width="130">
                                                        <ui:GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding ModName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModName}" />
                                                            </DataTemplate>
                                                        </ui:GridViewColumn.CellTemplate>
                                                    </ui:GridViewColumn>
                                                    <ui:GridViewColumn Header="Datei" Width="120">
                                                        <ui:GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding FileLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileLabel}" />
                                                            </DataTemplate>
                                                        </ui:GridViewColumn.CellTemplate>
                                                    </ui:GridViewColumn>
                                                    <ui:GridViewColumn Header="Art" DisplayMemberBinding="{Binding CategoriesLabel}" Width="64" />
                                                    <!-- Status as icon (text in tooltip) so all columns fit the narrow details card -->
                                                    <ui:GridViewColumn Header="" Width="40">
                                                        <ui:GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid Background="Transparent" ToolTip="{Binding StatusLabel}">
                                                                <ui:SymbolIcon>
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                    <Setter Property="Symbol" Value="Warning24" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ui:GridViewColumn.CellTemplate>
                                                    </ui:GridViewColumn>
                                                </ui:GridView>
                                            </ui:ListView.View>
                                        </ui:ListView>
                                        <TextBlock Text="Kein CC aus deinem Mods-Ordner gefunden – der Eintrag nutzt nur Spielinhalte (oder benötigter CC fehlt).">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=CcList}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Files in the wrong place (tray files in Mods, mods in Tray, unpacked downloads, ...) -->
                        <Expander Grid.Row="3" Margin="0,10,0,0" IsExpanded="False"
                          ToolTip="Dateien, die das Spiel an ihrem aktuellen Ort nicht lädt – aufklappen für Details und Lösungen.">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0" />
                                    <TextBlock><Run Text="Dateien am falschen Ort: " /><Run Text="{Binding Issues.Count, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </Expander.Header>
                            <Expander.Style>
                                <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Issues.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                                    <ui:Button Content="Automatisch aufräumen" Icon="{ui:SymbolIcon Broom24}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                               Command="{Binding FixIssuesCommand}"
                                               ToolTip="Tray-Dateien nach Tray und Mod-Dateien nach Mods verschieben. Identische Duplikate werden gesichert statt gelöscht." />
                                    <ui:Button Content="Archiv installieren" Icon="{ui:SymbolIcon Archive24}" HorizontalAlignment="Stretch"
                                               Command="{Binding InstallIssueArchiveCommand}"
                                               CommandParameter="{Binding SelectedItem, ElementName=IssueList}"
                                               ToolTip="Den links ausgewählten, nicht entpackten Download installieren." />
                                </StackPanel>
                                <ListBox x:Name="IssueList" ItemsSource="{Binding Issues}" MaxHeight="110"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                                       ToolTip="{Binding Path}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Expander>

                        <!-- Busy overlay while scanning / installing -->
                        <Border Grid.Row="0" Grid.RowSpan="4" CornerRadius="8"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.92">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                                <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================== Diagnose (error logs + 50/50) ============================== -->
                <TabItem DataContext="{Binding Diagnose}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Stethoscope24" Margin="0,0,6,0" />
                            <TextBlock Text="Diagnose" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="4,10,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" MinWidth="420" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" MinWidth="380" />
                        </Grid.ColumnDefinitions>

                        <!-- Error logs -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="1.3*" MinHeight="180" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Content="Alte aufräumen" Icon="{ui:SymbolIcon Broom24}" Margin="6,0,0,0" Command="{Binding CleanupOldLogsCommand}"
                                               ToolTip="Protokolle aus älteren Spielversionen in die Sicherung verschieben." />
                                    <ui:Button Icon="{ui:SymbolIcon Open24}" Margin="6,0,0,0" Command="{Binding OpenLogCommand}"
                                               ToolTip="Protokolldatei im Explorer zeigen" />
                                </StackPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="DocumentError24" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Fehlerprotokolle" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding LogSummary}" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <ui:ListView ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ui:ListView.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="ErrorCircle24" />
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOld}" Value="True">
                                                                    <Setter Property="Symbol" Value="History24" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding KindLabel, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Category, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding MetaLabel}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ui:ListView.ItemTemplate>
                                </ui:ListView>
                                <TextBlock Text="Keine Fehlerprotokolle vorhanden.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Details of the selected error -->
                            <Border Grid.Row="3" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <DockPanel DataContext="{Binding SelectedGroup}">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Headline}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding Advice}" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Suspects}"
                                                      Visibility="{Binding HasSuspects, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <ui:Button DockPanel.Dock="Right" Content="Deaktivieren" Icon="{ui:SymbolIcon DismissCircle24}" Margin="8,0,0,0"
                                                                   Command="{Binding DataContext.DisableSuspectCommand, ElementName=DiagnoseRoot}" CommandParameter="{Binding}" />
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Mod.DisplayName}" />
                                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Reason}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,6,0,4" Style="{StaticResource CaptionText}" Text="Protokoll:" />
                                    </StackPanel>
                                    <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- 50/50 assistant -->
                        <Border x:Name="DiagnoseRoot" Grid.Column="2" Padding="16,14" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="BranchFork24" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="50/50-Assistent" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Idle -->
                                <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsBisectIdle, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Text="Die bewährte Methode aus allen Sims-Foren, um einen kaputten Mod zu finden: Die Hälfte der Mods wird deaktiviert, du testest das Spiel, und je nach Ergebnis wird die verdächtige Hälfte weiter geteilt – bis nur noch der Verursacher übrig ist. Das Tool übernimmt das Umschalten und merkt sich den Fortschritt." />
                                    <TextBlock Margin="0,12,0,4" Text="Welches Problem tritt auf?" />
                                    <ui:TextBox PlaceholderText="z. B. „Absturz beim Laden“ oder „Sims bleiben stehen“" Text="{Binding BisectProblem, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button Margin="0,10,0,0" Content="50/50-Test starten" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Command="{Binding StartBisectCommand}" />
                                </StackPanel>

                                <!-- Running -->
                                <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsBisectRunning, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding BisectProgress}" />
                                    <TextBlock Margin="0,6,0,10" Style="{StaticResource CaptionText}" Text="{Binding BisectInstruction}" />
                                    <ui:Button Content="Spiel starten" Icon="{ui:SymbolIcon Play24}" Margin="0,0,0,10"
                                               Command="{Binding DataContext.Health.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               ToolTip="Startet das Spiel (ein ausgewähltes Spielprofil wird während des Tests nicht angewendet, wenn „aktuelle Auswahl“ eingestellt ist)." />
                                    <TextBlock Text="Tritt das Problem jetzt noch auf?" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <ui:Button Content="Ja, noch da" Icon="{ui:SymbolIcon ErrorCircle24}" Margin="0,0,6,6" Command="{Binding AnswerStillThereCommand}" />
                                        <ui:Button Content="Nein, weg" Icon="{ui:SymbolIcon CheckmarkCircle24}" Margin="0,0,6,6" Command="{Binding AnswerGoneCommand}" />
                                        <ui:Button Content="Abbrechen" Icon="{ui:SymbolIcon Dismiss24}" Margin="0,0,6,6" Command="{Binding StopBisectCommand}" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Finished -->
                                <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsBisectFinished, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Text="{Binding BisectProgress}" />
                                    <TextBlock Margin="0,6,0,6" Style="{StaticResource CaptionText}"
                                               Text="Verursacher gefunden – alle anderen Mods sind wieder aktiv. Den Verursacher deaktivieren und beim Ersteller nach einem Update schauen:" />
                                    <ItemsControl ItemsSource="{Binding BisectResult}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,10,0,0">
                                        <ui:Button Content="Verursacher deaktivieren" Icon="{ui:SymbolIcon DismissCircle24}" Appearance="Primary" Margin="0,0,6,6" Command="{Binding DisableCulpritCommand}" />
                                        <ui:Button Content="Schließen" Margin="0,0,6,6" Command="{Binding StopBisectCommand}" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Log -->
                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding BisectLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================== Saves ============================== -->
                <TabItem DataContext="{Binding Saves}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
                            <TextBlock Text="Spielstände" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="4,10,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="400" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.2*" MinWidth="420" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="Sichern" Icon="{ui:SymbolIcon ShieldCheckmark24}" Appearance="Primary" Margin="6,0,0,0" Command="{Binding BackupSelectedCommand}"
                                           ToolTip="Den ausgewählten Spielstand samt älteren Versionen sichern." />
                                <ui:Button Icon="{ui:SymbolIcon Open24}" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}" ToolTip="Spielstand im Explorer zeigen" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Spielstände" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Summary}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Saves list + backups -->
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:ListView ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ui:ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding SubtitleLabel}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ui:ListView.ItemTemplate>
                            </ui:ListView>

                            <!-- Automatic backups (E3) -->
                            <Expander Grid.Row="1" Margin="0,8,0,0">
                                <Expander.Header>
                                    <DockPanel>
                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ShieldCheckmark24" Margin="0,0,8,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="Automatische Sicherung" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AutoBackupStatus}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <WrapPanel>
                                        <CheckBox Content="Vor jedem Spielstart: Spielstände" IsChecked="{Binding BackupSavesBeforePlay}" Margin="0,0,14,4" />
                                        <CheckBox Content="und Bibliothek (Tray)" IsChecked="{Binding BackupTrayBeforePlay}" Margin="0,0,14,4"
                                                  ToolTip="Spiegelt den Tray-Ordner: kopiert nur neue oder geänderte Dateien. Überschriebene und gelöschte Einträge bleiben 30 Tage unter „Ältere Stände“." />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Zusätzlich beim App-Start:" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <ComboBox Width="130" Margin="0,0,14,4" ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding Interval}" />
                                        <TextBlock Text="Behalten pro Slot:" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <ComboBox Width="70" Margin="0,0,0,4" ItemsSource="{Binding KeepOptions}" SelectedItem="{Binding KeepPerSlot}"
                                                  ToolTip="Ältere automatische Sicherungen werden gelöscht. Von Hand angelegte Sicherungen bleiben immer." />
                                    </WrapPanel>
                                    <ui:Button Content="Jetzt sichern" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding BackupNowCommand}" Margin="0,4,0,0"
                                               ToolTip="Automatische Sicherung sofort ausführen: alle Spielstände und – falls eingeschaltet – die Bibliothek." />
                                </StackPanel>
                            </Expander>

                            <Expander Grid.Row="2" Margin="0,8,0,0">
                                <Expander.Header>
                                    <TextBlock><Run Text="Sicherungen (" /><Run Text="{Binding Backups.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                                </Expander.Header>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                        <ui:Button Content="Sicherungsordner öffnen" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,6,0" />
                                        <ui:Button Content="Bibliotheks-Spiegel öffnen" Icon="{ui:SymbolIcon Library24}" Command="{Binding OpenTrayMirrorCommand}" />
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Backups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <ui:Button DockPanel.Dock="Right" Content="Wiederherstellen" Icon="{ui:SymbolIcon ArrowUndo24}"
                                                                   Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Expander>
                        </Grid>

                        <!-- Details -->
                        <Border Grid.Row="1" Grid.Column="2" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel DataContext="{Binding SelectedSave}">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ContentLabel}" />
                                    <TextBlock Style="{StaticResource HideWhenEmpty}" Text="{Binding CreatedLabel}" />
                                    <TextBlock Margin="0,8,0,2" FontWeight="SemiBold" Text="Haushalte" />
                                    <TextBlock Style="{StaticResource CaptionText}" MaxHeight="58" TextTrimming="WordEllipsis"
                                               Text="{Binding Households, Converter={StaticResource JoinConverter}}" />
                                    <TextBlock Margin="0,10,0,6" FontWeight="SemiBold">
                                        <Run Text="Verwendeter CC: " /><Run Text="{Binding CcLabel, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <ui:ListView ItemsSource="{Binding Cc}">
                                    <ui:ListView.View>
                                        <ui:GridView>
                                            <ui:GridViewColumn Header="Mod" Width="170">
                                                <ui:GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding ModName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModName}" /></DataTemplate>
                                                </ui:GridViewColumn.CellTemplate>
                                            </ui:GridViewColumn>
                                            <ui:GridViewColumn Header="Datei" Width="170">
                                                <ui:GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding FileLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileLabel}" /></DataTemplate>
                                                </ui:GridViewColumn.CellTemplate>
                                            </ui:GridViewColumn>
                                            <ui:GridViewColumn Header="Art" DisplayMemberBinding="{Binding CategoriesLabel}" Width="70" />
                                            <ui:GridViewColumn Header="Status" DisplayMemberBinding="{Binding StatusLabel}" Width="90" />
                                        </ui:GridView>
                                    </ui:ListView.View>
                                </ui:ListView>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================== Storage ============================== -->
                <TabItem DataContext="{Binding Storage}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Storage24" Margin="0,0,6,0" />
                            <TextBlock Text="Speicherplatz" />
                        </StackPanel>
                    </TabItem.Header>
                    <TabItem.Resources>
                        <DataTemplate x:Key="StorageBarTemplate">
                            <Grid Margin="0,3,14,3" Background="Transparent" ToolTip="{Binding CountLabel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" x:Name="Track" VerticalAlignment="Center" Height="12">
                                    <Border CornerRadius="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <Border CornerRadius="3" Background="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource FractionWidth}">
                                                <Binding Path="Fraction" />
                                                <Binding Path="ActualWidth" ElementName="Track" />
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                        <Style x:Key="StorageCard" TargetType="Border">
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        </Style>
                    </TabItem.Resources>

                    <Grid Margin="4,10,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Key figures -->
                        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,10">
                            <Border Style="{StaticResource StorageCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Mods-Ordner gesamt" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding TotalLabel}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StorageCard}" Margin="0,0,8,0" ToolTip="Deaktivierte Mods belegen weiter Platz, werden aber nicht geladen.">
                                <StackPanel>
                                    <TextBlock Text="davon deaktiviert" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding DisabledLabel}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StorageCard}" Margin="0,0,8,0" ToolTip="Byte-identische Dateien an mehreren Stellen: alle Kopien bis auf eine sind überflüssig.">
                                <StackPanel>
                                    <TextBlock Text="Doppelte Dateien" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding DuplicatesLabel}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StorageCard}" ToolTip="Ressourcen, die ohne Kompression im Package liegen. Komprimieren spart hier meist gut die Hälfte – verlustfrei, der Inhalt im Spiel bleibt gleich.">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowMinimize24}" Content="Komprimieren …" VerticalAlignment="Center"
                                               Command="{Binding CompressAllCommand}" Margin="8,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="Unkomprimiert gespeichert" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding UncompressedLabel}" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource StorageCard}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Nach Kategorie" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ByCategory}" ItemTemplate="{StaticResource StorageBarTemplate}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StorageCard}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Nach Ersteller" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ByCreator}" ItemTemplate="{StaticResource StorageBarTemplate}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource StorageCard}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Größte Mods (Doppelklick zeigt den Mod)" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                    <ListBox ItemsSource="{Binding Largest}" ItemTemplate="{StaticResource StorageBarTemplate}" x:Name="LargestList"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0"
                                             MouseDoubleClick="LargestList_MouseDoubleClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="4,0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource StorageCard}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <ui:Button DockPanel.Dock="Right" Content="Überzählige Kopien entfernen" Icon="{ui:SymbolIcon Delete24}"
                                                   Command="{Binding RemoveDuplicatesCommand}" IsEnabled="{Binding HasDuplicates}"
                                                   ToolTip="Von jeder Datei bleibt genau eine Kopie (✓). Die anderen (✗) wandern in die Sicherung und lassen sich über den Verlauf zurückholen." />
                                        <TextBlock Text="Doppelte Dateien" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Duplicates}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding WastedLabel, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                                                            <ItemsControl ItemsSource="{Binding Paths}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Text="Keine doppelten Dateien gefunden.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDuplicates}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ============================== History (backup journal) ============================== -->
                <TabItem DataContext="{Binding History}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" Margin="0,0,6,0" />
                            <TextBlock Text="Verlauf" />
                        </StackPanel>
                    </TabItem.Header>

                    <TabControl Margin="4,6,4,4">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" Margin="0,0,6,0" />
                                <TextBlock Text="Aktionen" />
                            </StackPanel>
                        </TabItem.Header>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <ui:Button Content="Rückgängig machen" Icon="{ui:SymbolIcon ArrowUndo24}" Appearance="Primary" Margin="6,0,0,0"
                                           Command="{Binding UndoSelectedCommand}"
                                           ToolTip="Die ausgewählte Aktion zurücknehmen (Strg+Z nimmt die letzte Aktion zurück)." />
                                <ui:Button Content="Sicherung öffnen" Icon="{ui:SymbolIcon FolderOpen24}" Margin="6,0,0,0"
                                           Command="{Binding OpenFolderCommand}"
                                           ToolTip="Den Sicherungsordner dieser Aktion im Explorer öffnen." />
                                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Margin="6,0,0,0" Command="{Binding RefreshCommand}"
                                           ToolTip="Verlauf neu laden" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Jede Änderung an Mods und Bibliothek wird gesichert" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="Aktivieren/Deaktivieren, Profile, Installationen, Aufräumen, Entfernen und Konfliktlösungen lassen sich hier einzeln zurücknehmen. Geänderte Dateien werden vorher kopiert; die letzten 100 Aktionen bleiben erhalten." />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="380" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.2*" MinWidth="380" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <ui:ListView x:Name="HistoryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ui:ListView.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="History24" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                                                    <Setter Property="Symbol" Value="ArrowUndo24" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        <Setter Property="Opacity" Value="0.6" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource CaptionText}">
                                                        <Run Text="{Binding DateLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding OperationsLabel, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource WarningBrush}"
                                                               Style="{StaticResource HideWhenEmpty}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ui:ListView.ItemTemplate>
                                </ui:ListView>
                                <TextBlock Text="Noch keine Änderungen – sobald Mods aktiviert, installiert oder Konflikte gelöst werden, erscheinen die Sicherungspunkte hier.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                            <!-- Files of the selected change set -->
                            <Border Grid.Column="2" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <DockPanel DataContext="{Binding SelectedEntry}">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                                            <Run Text="{Binding DateLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding OperationsLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:ListView ItemsSource="{Binding Operations}">
                                        <ui:ListView.View>
                                            <ui:GridView>
                                                <ui:GridViewColumn Header="Aktion" DisplayMemberBinding="{Binding KindLabel}" Width="100" />
                                                <ui:GridViewColumn Header="Datei" Width="360">
                                                    <ui:GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                                        </DataTemplate>
                                                    </ui:GridViewColumn.CellTemplate>
                                                </ui:GridViewColumn>
                                            </ui:GridView>
                                        </ui:ListView.View>
                                    </ui:ListView>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentSearch24" Margin="0,0,6,0" />
                                <TextBlock Text="Was hat sich geändert?" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                                       Text="Vergleicht den Mods-Ordner mit einem früheren Stand: Er wird einmal täglich und vor jedem Start über „Spielen“ festgehalten (die letzten 30). So lässt sich z. B. nach einem Absturz sehen, was seit dem letzten funktionierenden Spielen neu dazugekommen ist." />
                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="Vergleichen mit:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0" Command="{Binding RefreshChangesCommand}" ToolTip="Neu vergleichen" />
                                <ComboBox Width="360" HorizontalAlignment="Left" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" DisplayMemberPath="Label" />
                            </DockPanel>
                            <DockPanel Grid.Row="2">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding ChangesSummary}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                <ui:ListView ItemsSource="{Binding Changes}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True">
                                    <ui:ListView.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding Symbol}" Margin="0,0,8,0" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Kind}" Width="96" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ui:ListView.ItemTemplate>
                                </ui:ListView>
                            </DockPanel>
                        </Grid>
                    </TabItem>
                    </TabControl>
                </TabItem>

                <!-- ============================== Game (index, default replacements, missing meshes) ============================== -->
                <TabItem DataContext="{Binding Game}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Games24" Margin="0,0,6,0" />
                            <TextBlock Text="Spiel" />
                        </StackPanel>
                    </TabItem.Header>
                    <TabItem.Resources>
                        <Style x:Key="GameCard" TargetType="Border">
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        </Style>
                    </TabItem.Resources>

                    <Grid Margin="4,10,4,4" x:Name="GameRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource GameCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <ui:Button Content="Spielordner wählen …" Icon="{ui:SymbolIcon FolderOpen24}" Margin="6,0,0,0"
                                                   Command="{Binding ChooseInstallFolderCommand}"
                                                   ToolTip="Nur nötig, wenn die Installation nicht automatisch gefunden wird (EA App, Origin, Steam)." />
                                        <ui:Button Icon="{ui:SymbolIcon Open24}" Margin="6,0,0,0" Command="{Binding OpenInstallFolderCommand}" ToolTip="Spielordner öffnen" />
                                        <ui:Button Content="Neu einlesen" Icon="{ui:SymbolIcon ArrowSync24}" Margin="6,0,0,0" Command="{Binding RebuildIndexCommand}"
                                                   ToolTip="Den Spielindex neu aufbauen. Passiert nach Spiel-Updates und neuen Packs automatisch." />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeader}"><Run Text="Installation: " /><Run Text="{Binding InstallLabel, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding IndexLabel}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding BusyText}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <Expander Margin="0,8,0,0" Header="{Binding PacksHeader}" Visibility="{Binding HasIndex, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Packs}" MaxHeight="150">
                                        <ItemsControl.Template>
                                            <ControlTemplate>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock Text="{Binding}" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource GameCard}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                        <CheckBox DockPanel.Dock="Right" Content="Nur mit Tuning" IsChecked="{Binding OnlyTuning}"
                                                  ToolTip="Tuning-Overrides verändern Spielregeln – sie brechen nach Spiel-Updates am häufigsten." />
                                        <TextBlock Text="{Binding ReplacementsHeader}" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="Default Replacements ersetzen Texturen, Meshes, CAS-Teile oder Slider des Spiels. Von zwei Mods, die dasselbe ersetzen, wirkt nur einer. Tuning wird am Namen und an der ID erkannt – eine Schätzung. Doppelklick zeigt den Mod." />
                                    <Grid>
                                        <ui:ListView x:Name="ReplacementList" ItemsSource="{Binding Replacements}" MouseDoubleClick="ReplacementList_MouseDoubleClick">
                                            <ui:ListView.View>
                                                <ui:GridView>
                                                    <ui:GridViewColumn Header="Mod" Width="210">
                                                        <ui:GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ModName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModName}" />
                                                                    <TextBlock Text="{Binding FileLabel}" Style="{StaticResource HideWhenEmpty}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource HideWhenEmpty}" Foreground="{StaticResource WarningBrush}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ui:GridViewColumn.CellTemplate>
                                                    </ui:GridViewColumn>
                                                    <ui:GridViewColumn Header="Ersetzt" Width="300">
                                                        <ui:GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding TuningLabel}" Style="{StaticResource HideWhenEmpty}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ui:GridViewColumn.CellTemplate>
                                                    </ui:GridViewColumn>
                                                </ui:GridView>
                                            </ui:ListView.View>
                                        </ui:ListView>
                                        <TextBlock Text="Keine Mods, die Spielinhalte ersetzen.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasReplacements}" Value="False" />
                                                                <Condition Binding="{Binding HasIndex}" Value="True" />
                                                                <Condition Binding="{Binding IsBusy}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource GameCard}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding MissingHeader}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="Recolors verweisen auf das Mesh eines anderen Erstellers. Fehlt es, ist der CC im Spiel unsichtbar oder taucht gar nicht auf. Das Mesh muss separat heruntergeladen werden." />
                                    <Grid>
                                        <ui:ListView x:Name="MissingMeshList" ItemsSource="{Binding MissingMeshes}" MouseDoubleClick="MissingMeshList_MouseDoubleClick"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ui:ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4">
                                                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Search24}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Command="{Binding DataContext.SearchMeshCommand, ElementName=GameRoot}" CommandParameter="{Binding}"
                                                                   ToolTip="Im Web nach dem Mesh suchen" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ModName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModName}" />
                                                            <TextBlock Text="{Binding FileLabel}" Style="{StaticResource HideWhenEmpty}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Item}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MeshLabel}" />
                                                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource CaptionText}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ui:ListView.ItemTemplate>
                                        </ui:ListView>
                                        <TextBlock Text="Alle Recolors haben ihr Mesh.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasMissingMeshes}" Value="False" />
                                                                <Condition Binding="{Binding HasIndex}" Value="True" />
                                                                <Condition Binding="{Binding IsBusy}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ============================== Updates (CurseForge) ============================== -->
                <TabItem DataContext="{Binding Updates}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0" />
                            <TextBlock Text="Updates" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4,10,4,4" x:Name="UpdatesRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="14,10" CornerRadius="8" BorderThickness="1" Margin="0,0,0,10"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="CurseForge" Style="{StaticResource SectionHeader}" />
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,8"
                                           Text="Erkennt Mods von CurseForge an ihrem Datei-Fingerabdruck und zeigt neuere Versionen an. Die Update-Prüfung braucht einen eigenen, kostenlosen API-Schlüssel von CurseForge – er wird verschlüsselt für dein Windows-Konto gespeichert und nur an api.curseforge.com gesendet." />
                                <DockPanel Visibility="{Binding HasApiKey, Converter={StaticResource InverseBoolToVisibility}}">
                                    <ui:Button DockPanel.Dock="Right" Content="Schlüssel beantragen" Icon="{ui:SymbolIcon Open24}" Margin="6,0,0,0"
                                               Command="{Binding OpenApiKeyPageCommand}" ToolTip="{Binding ApiKeyUrl}" />
                                    <ui:Button DockPanel.Dock="Right" Content="Speichern" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="6,0,0,0"
                                               Command="{Binding SaveApiKeyCommand}" />
                                    <ui:TextBox Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="CurseForge-API-Schlüssel einfügen …" Icon="{ui:SymbolIcon Key24}" />
                                </DockPanel>
                                <DockPanel Visibility="{Binding HasApiKey, Converter={StaticResource BoolToVisibility}}">
                                    <ui:Button DockPanel.Dock="Right" Content="Schlüssel entfernen" Icon="{ui:SymbolIcon Delete24}" Margin="6,0,0,0" Command="{Binding RemoveApiKeyCommand}" />
                                    <ui:Button DockPanel.Dock="Right" Content="Abbrechen" Margin="6,0,0,0" Command="{Binding CancelCommand}"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="Nach Updates suchen" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary"
                                                   Command="{Binding CheckCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="12,0,8,0"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <DockPanel Grid.Row="1" Margin="0,0,0,6">
                            <CheckBox DockPanel.Dock="Right" Content="Nur Mods mit Update" IsChecked="{Binding OnlyUpdates}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>

                        <ui:ListView Grid.Row="2" x:Name="UpdateList" ItemsSource="{Binding Mods}" MouseDoubleClick="UpdateList_MouseDoubleClick">
                            <ui:ListView.View>
                                <ui:GridView>
                                    <ui:GridViewColumn Header="CurseForge-Projekt" Width="220">
                                        <ui:GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Authors}" Style="{StaticResource HideWhenEmpty}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ui:GridViewColumn.CellTemplate>
                                    </ui:GridViewColumn>
                                    <ui:GridViewColumn Header="Im Mods-Ordner" Width="180" DisplayMemberBinding="{Binding LocalLabel}" />
                                    <ui:GridViewColumn Header="Installiert" Width="180" DisplayMemberBinding="{Binding InstalledLabel}" />
                                    <ui:GridViewColumn Header="Neueste" Width="180" DisplayMemberBinding="{Binding LatestLabel}" />
                                    <ui:GridViewColumn Header="Status" Width="230">
                                        <ui:GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ui:Button Content="Aktualisieren" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Padding="8,2"
                                                               Command="{Binding DataContext.UpdateModCommand, ElementName=UpdatesRoot}" CommandParameter="{Binding}"
                                                               Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:Button Icon="{ui:SymbolIcon Open24}" Margin="4,0,0,0" Padding="6,2" ToolTip="CurseForge-Seite öffnen"
                                                               Command="{Binding DataContext.OpenPageCommand, ElementName=UpdatesRoot}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ui:GridViewColumn.CellTemplate>
                                    </ui:GridViewColumn>
                                </ui:GridView>
                            </ui:ListView.View>
                        </ui:ListView>

                        <TextBlock Grid.Row="3" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Mods von Patreon, Tumblr oder eigenen Seiten lassen sich nicht automatisch prüfen. Trage ihren Download-Link in den Notizen ein (Tab „Mods“ → Details) – dann findest du die Quelle jederzeit wieder. Nach Spiel-Updates warnt die Übersicht vor veralteten Skript- und Tuning-Mods." />
                    </Grid>
                </TabItem>
            </TabControl>
            </DockPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="14,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <!-- Toast notifications: brief pop-ups for background events (silent update checks, scheduled backups). -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,16,52" Focusable="False" ItemsSource="{Binding Toasts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="320" Margin="0,0,0,8" Padding="12,10" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" />
                        </Border.Effect>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" BorderThickness="0" Padding="4"
                                       VerticalAlignment="Top" Margin="6,-2,-4,0"
                                       Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                            </ui:Button>
                            <Border DockPanel.Dock="Left" Width="3" Margin="0,0,10,0" CornerRadius="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</ui:FluentWindow>
